# Пример переменных окружения. Скопируйте в .env и подставьте свои значения.
# Реальный .env в репозиторий не коммитим.

# --- PostgreSQL ---
POSTGRES_DB=ege_flow
POSTGRES_USER=ege_flow
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Backend (FastAPI) ---
# Для локальной разработки: http://localhost:8000/api/v1
# Строка подключения собирается из переменных POSTGRES_*
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Проверка JWT (сервис аутентификации) ---
# Алгоритм и способ получения ключа зависят от сервиса аутентификации и пока не определены.
JWT_ALGORITHM=
JWT_PUBLIC_KEY_OR_SECRET=

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000/api/v1
